# Copy to .env for local experiments, or use Doppler in production.
# Never commit real secrets.

# --- Required ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Provider key for AI_PROVIDER (openai | gemini | claude)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- AI provider ---
AI_PROVIDER=openai
OPENAI_MODEL_NAME=gpt-5.4-nano
# GEMINI_MODEL_NAME=gemini-3-flash-preview
# CLAUDE_MODEL_NAME=claude-sonnet-4-6
# Optional backups when the primary model returns busy/overloaded errors.
# Provider is inferred from the model ID; override with SECONDARY_AI_PROVIDER / TERTIARY_AI_PROVIDER.
# SECONDARY_MODEL_NAME=gpt-5.4-mini
# SECONDARY_AI_PROVIDER=openai
# TERTIARY_MODEL_NAME=claude-haiku-4-5
# TERTIARY_AI_PROVIDER=claude
# Cross-provider example (Gemini primary, OpenAI secondary, Claude tertiary):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# SECONDARY_MODEL_NAME=gpt-5.4-mini
# TERTIARY_MODEL_NAME=claude-haiku-4-5
# TERTIARY_AI_PROVIDER=claude

# --- Access control (production: set ALLOWED_GUILD_IDS) ---
# Comma-separated guild IDs. Empty = all guilds and DMs allowed.
# Non-empty = listed guilds only; DMs blocked; bot leaves other servers on contact.
# ALLOWED_GUILD_IDS=

# --- Conversation limits ---
MAX_HISTORY_LENGTH=10
# Recommended in production for long channels:
# MAX_HISTORY_TOKENS=8000
MAX_OUTPUT_TOKENS=1024

# --- Anti-spam (set to 0 to disable) ---
# USER_COOLDOWN_MS applies per user per channel (not globally across channels).
USER_COOLDOWN_MS=4000
CHANNEL_COOLDOWN_MS=1500
MAX_PENDING_PER_CHANNEL=3

# --- Scaling (optional) ---
# DISCORD_SHARD_COUNT=auto
# DISCORD_SHARD_COUNT=2

# --- Provider timeouts (ms) ---
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=60000
CLAUDE_TIMEOUT_MS=60000

# --- Optional features ---
# ENABLE_WEB_SEARCH=false
# ENABLE_GOOGLE_MAPS=false
# ENABLE_CONTEXT_CACHE=true

# IMAGE_GENERATION_TIMEOUT_MS=120000
# GEMINI_IMAGE_MODEL_NAME=gemini-3.1-flash-image
# SECONDARY_GEMINI_IMAGE_MODEL_NAME=gemini-2.5-flash-image
# IMAGE_USER_COOLDOWN_MS=30000

# --- Sentry (production defaults: 10% trace/profile sampling) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
# SENTRY_ENABLE_LOGS=true

# --- Logging ---
LOG_LEVEL=info
