{
  "name": "ai",
  "version": "1.0.0",
  "description": "A Discord bot that uses AI to respond to messages.",
  "main": "index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "doppler run -- nodemon index.js",
    "start": "doppler run -- node index.js",
    "commands:deploy": "doppler run -- node deploy-commands.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "audit:logs": "node scripts/audit-log-messages.js",
    "rebuild": "pnpm rebuild",
    "predeploy": "pnpm test && pnpm commands:deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@sentry-internal/node-cpu-profiler",
      "@sentry/node-cpu-profiler",
      "@sentry/profiling-node",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "tar": ">=7.5.11"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubleangels/ai.git"
  },
  "author": "doubleangels",
  "bugs": {
    "url": "https://github.com/doubleangels/ai/issues"
  },
  "homepage": "https://github.com/doubleangels/ai#readme",
  "overrides": {
    "tar": ">=7.5.11",
    "minimatch": ">=10.2.1",
    "brace-expansion": ">=5.0.6",
    "ip-address": ">=10.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@discordjs/rest": "^2.6.1",
    "@google/genai": "^2.10.0",
    "@sentry/node": "^10.63.0",
    "@sentry/profiling-node": "^10.63.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "openai": "^6.45.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  }
}
