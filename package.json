{
  "name": "ai",
  "version": "1.0.0",
  "description": "A Discord bot that uses AI to respond to messages.",
  "main": "index.js",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "doppler run -- nodemon index.js",
    "start": "doppler run -- node index.js",
    "commands:deploy": "doppler run -- node deploy-commands.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "audit:logs": "node scripts/audit-log-messages.js",
    "rebuild": "pnpm rebuild",
    "predeploy": "pnpm test && pnpm commands:deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubleangels/ai.git"
  },
  "author": "doubleangels",
  "bugs": {
    "url": "https://github.com/doubleangels/ai/issues"
  },
  "homepage": "https://github.com/doubleangels/ai#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@discordjs/rest": "^2.6.3",
    "@google/genai": "^3.3.0",
    "@sentry/node": "^11.12.0",
    "@sentry/profiling-node": "^11.12.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "openai": "^7.56.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
