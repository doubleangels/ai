{
  "name": "ai",
  "version": "1.0.0",
  "description": "A Discord bot that uses AI to respond to messages.",
  "main": "index.js",
  "scripts": {
    "dev": "doppler run -- nodemon index.js",
    "start": "doppler run -- node index.js",
    "commands:deploy": "doppler run -- node deploy-commands.js",
    "test": "node --require ./test/preload.cjs --test",
    "test:coverage": "c8 npm test",
    "test:coverage:check": "c8 --check-coverage --lines 90 npm test",
    "rebuild": "npm rebuild",
    "predeploy": "npm run test && npm run commands:deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubleangels/ai.git"
  },
  "author": "doubleangels",
  "bugs": {
    "url": "https://github.com/doubleangels/ai/issues"
  },
  "homepage": "https://github.com/doubleangels/ai#readme",
  "overrides": {
    "tar": ">=7.5.8",
    "minimatch": ">=10.2.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@discordjs/rest": "^2.6.1",
    "@google/genai": "^2.5.0",
    "@sentry/node": "^10.32.0",
    "@sentry/profiling-node": "^10.53.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "openai": "^6.38.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "nodemon": "^3.1.14"
  }
}
