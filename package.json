{
  "name": "ai",
  "version": "1.0.0",
  "description": "A Discord bot that uses AI to respond to messages.",
  "main": "index.js",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "doppler run -- node --watch index.js",
    "start": "doppler run -- node index.js",
    "commands:deploy": "doppler run -- node deploy-commands.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "audit:logs": "node scripts/audit-log-messages.js",
    "rebuild": "pnpm rebuild",
    "predeploy": "pnpm test && pnpm commands:deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubleangels/ai.git"
  },
  "author": "doubleangels",
  "bugs": {
    "url": "https://github.com/doubleangels/ai/issues"
  },
  "homepage": "https://github.com/doubleangels/ai#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@discordjs/rest": "^2.6.3",
    "@google/genai": "^3.3.0",
    "@sentry/node": "^11.13.0",
    "@sentry/profiling-node": "^11.12.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "openai": "^7.57.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
